{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Messages Bridge",
  "version": "0.1.0",
  "identifier": "com.kio.messages-bridge",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Messages",
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
