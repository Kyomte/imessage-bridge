{
  "name": "imessage-bridge",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "setup": "npm run setup -w server",
    "dev": "npm run dev -w server & npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "service:install": "zsh scripts/service/install.sh",
    "service:uninstall": "zsh scripts/service/uninstall.sh",
    "service:restart": "launchctl kickstart -k gui/$(id -u)/com.kio.imessage-bridge",
    "service:logs": "tail -f ~/Library/Logs/imessage-bridge/server.log"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
